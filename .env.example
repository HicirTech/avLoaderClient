# Copy to `.env` and adjust. Every value is optional; the default in
# src/config.ts applies to anything left out.

# The library folder. Downloads arrive inside a folder per torrent, so files are
# gathered from the folders below this one and moved up into it, their names
# cleaned up on the way.
TARGET_PATH=Z:\Garage\临时

# Only files with this extension are considered.
TARGET_EXTENSION=mp4

# Anything smaller than this is advertising rather than a movie. Torrents often
# carry a clip a few megabytes long, sometimes several with the same name.
MIN_FILE_SIZE_MB=50

# Where avloaderServer is listening.
METADATA_HOST=http://192.168.10.102:5000

# Whole Cookie header from a browser that loads javdb.com without a challenge.
# Must contain cf_clearance. The server refuses the lookup without it.
JAVDB_COOKIE=

# Where the .nfo files are written. A name with a .nfo already beside the video
# or in here is treated as finished and is not looked up again.
OUTPUT_DIR=./output

# Pause between lookups. The server paces its own requests to javdb as well, so
# this is politeness on top of that rather than the only protection.
FETCH_DELAY_MS=5000
